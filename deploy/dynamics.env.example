# Append to /opt/dhole/.env (production) or /opt/dhole/.env.staging (staging).
# NEVER put secrets or real credentials in this template.
DYNAMICS_HTTP_URL=http://dynamics-api:8080
DYNAMICS_IMAGE_TAG=CHANGE_TO_ENVIRONMENT_TAG
DYNAMICS_POSTGRES_PASSWORD_FILE=/opt/dhole/dynamics/ENV/postgres_password
DYNAMICS_DB_CONNECTION_FILE=/opt/dhole/dynamics/ENV/database_connection
DYNAMICS_ENCRYPTION_KEY_FILE=/opt/dhole/dynamics/ENV/encryption_key
DYNAMICS_CURSOR_KEY_FILE=/opt/dhole/dynamics/ENV/cursor_key
DYNAMICS_ADMIN_OIDC_SECRET_FILE=/opt/dhole/dynamics/ENV/oidc_client_secret
DYNAMICS_DP_CERT_FILE=/opt/dhole/dynamics/ENV/data_protection.pfx
DYNAMICS_DP_PASSWORD_FILE=/opt/dhole/dynamics/ENV/data_protection_password
DYNAMICS_ADMIN_OIDC_AUTHORITY=https://login.microsoftonline.com/REPLACE_TENANT/v2.0
DYNAMICS_ADMIN_OIDC_CLIENT_ID=REPLACE_WITH_OWN_ENTRA_ADMIN_APP_ID
DYNAMICS_M2M_AUTHORITY=https://login.microsoftonline.com/REPLACE_TENANT/v2.0
DYNAMICS_M2M_AUDIENCE=api://REPLACE_WITH_CONNECTOR_RESOURCE_APP_ID
DYNAMICS_JOBS_ENABLED=false
DYNAMICS_PRODUCTION_WRITES_APPROVED=NO
DYNAMICS_PRODUCTION_WRITES_TICKET=
DYNAMICS_PRODUCTION_DELETES_APPROVED=NO
DYNAMICS_PRODUCTION_DELETES_TICKET=

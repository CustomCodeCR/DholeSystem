# This is an example ONLY. Values for PostgreSQL and JWT already exist in DholeSystem's
# /opt/dhole/.env and /opt/dhole/.env.staging; do not repeat or replace them.
# Copy just these lines if missing:
DYNAMICS_DB=dhole_dynamics_connector
DYNAMICS_HTTP_URL=http://dynamics-api:8080
DYNAMICS_IMAGE_TAG=latest
DYNAMICS_JOBS_ENABLED=false
DYNAMICS_PRODUCTION_WRITES_APPROVED=NO
# The production CRUD workflow generates an audit reference from GitHub Actions.
# Do not add *_TICKET values manually to /opt/dhole/.env.
# Set WRITES=YES only for a reviewed production DEPLOY_FULL_CRUD release.
# Only the exact crear_oferta/execute-with-total route; must have an approved ticket.
# This is OFF by default and does not enable generic Dataverse writes.
DYNAMICS_PRODUCTION_QUOTE_WRITES_APPROVED=NO
DYNAMICS_PRODUCTION_QUOTE_WRITES_TICKET=
DYNAMICS_PRODUCTION_DELETES_APPROVED=NO
# Optional M2M API settings (real Entra values required before external clients work).
# DYNAMICS_M2M_AUTHORITY=https://login.microsoftonline.com/<REAL_TENANT_GUID>/v2.0
# DYNAMICS_M2M_AUDIENCE=api://<REAL_RESOURCE_APP_ID>
# Do NOT add an external application's client secret to this file.


# Staging ONLY: DYNAMICS_IMAGE_TAG=staging.
# Real Dataverse TenantId, ClientId and ClientSecret are registered through
# POST /api/dynamics-admin/connections and encrypted in dynamics.connections.
# Never write them into this environment file.
